ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://sse_user:change-me@db:5432/sse_ra0

# HS256 pide una clave de al menos 32 bytes (RFC 7518 3.2); con menos, PyJWT
# avisa en cada firma. Generar una propia con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-every-environment-con-al-menos-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Modulo externo (independiente de este proyecto) que valida credenciales.
# No confundir con la futura integracion SSO real (ver domains/auth/adapters/sso/README.md).
EXTERNAL_AUTH_API_URL=https://change-me.example/api/validate-credentials

CORS_ORIGINS=http://localhost:5173

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

REALTIME_MAX_LATENCY_SECONDS=2

# --- Senal SERMO por MQTT (ver docs/decisions/0004-representacion-sermo.md)
# El estado de operacion del reactor llega como mensaje MQTT publicado por la
# FPGA; no se deriva de la base. MQTT_ENABLED=false levanta el backend sin
# ingesta (util para trabajar contra datos ya cargados con seed.py, sin broker).
MQTT_ENABLED=true
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC_SERMO=ra0/sermo
MQTT_QOS=1
# Debe ser unico por cliente: dos con el mismo id se desconectan mutuamente.
MQTT_CLIENT_ID=sse-backend
# El broker de desarrollo acepta conexiones anonimas. En el reactor hay que
# completar estas dos y endurecer infra/mosquitto/mosquitto.conf.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# --- Toma de datos
# "simulated" genera las muestras; "main_pc" las lee de la PC principal del
# reactor (sin implementar todavia).
ACQUISITION_SOURCE=simulated
ACQUISITION_INTERVAL_SECONDS=1.0
ACQUISITION_DEFAULT_OPERATOR=Desconocido
