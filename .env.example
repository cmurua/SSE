# Variables compartidas por docker-compose. Cada app tiene ademas su propio
# .env.example (apps/backend/.env.example, apps/frontend/.env.example).

COMPOSE_PROJECT_NAME=sse-ra0

POSTGRES_USER=sse_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sse_ra0
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Broker MQTT: por aca llega la senal SERMO que publica la FPGA.
MQTT_PORT=1883
